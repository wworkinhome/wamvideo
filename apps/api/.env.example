# Opción A: Postgres local vía Docker Compose (docker-compose.yml en la raíz)
DATABASE_URL="postgresql://wamvideo:wamvideo@localhost:5432/wamvideo?schema=public"
DIRECT_URL="postgresql://wamvideo:wamvideo@localhost:5432/wamvideo?schema=public"

# Opción B: Supabase — descomenta y completa con los datos de tu proyecto
# (Settings > Database en el dashboard de Supabase).
# DATABASE_URL: connection string del "Transaction pooler" (puerto 6543,
#   compatible con IPv4, usado por la app en tiempo de ejecución).
# DIRECT_URL: connection string de "Direct connection" (puerto 5432, la usa
#   Prisma solo para migraciones; requiere que tu red soporte IPv6).
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
